---
// The glossary: each term has an id to link to, and the whole set is given to search engines
// as a DefinedTermSet.
import { definedTermSet } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { TERMS } from '../content/glossary';

const terms = TERMS.map((term) => ({ ...term }));
const title = 'Glossary of national statistics';
---

<Page
  site={site}
  title={title}
  description="The words behind a nation’s numbers, in a sentence or two each: nominal GDP and PPP, fertility rate, density, dependency ratio, primate city and more."
  crumbs={[{ name: 'Glossary', path: '/glossary/' }]}
  jsonld={[definedTermSet(site, { name: title, path: '/glossary/', terms })]}
>
  <article class="eu-prose">
    <p class="eu-kicker">Glossary</p>
    <h1>{title}</h1>
    <p class="eu-lead">
      The words Stats uses, in a sentence or two each. The <a href="/guide/">guide</a> shows how they fit together; the <a href="/">checker</a> puts them to work.
    </p>
    <dl>
      {
        terms.map((term) => (
          <>
            <dt id={term.id}>{term.term}</dt>
            <dd>{term.definition}</dd>
          </>
        ))
      }
    </dl>
  </article>
</Page>
